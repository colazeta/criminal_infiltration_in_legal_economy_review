{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colazeta.github.io/criminal_infiltration_in_legal_economy_review/schema/surveillance-run.schema.json",
  "title": "Daily academic surveillance run",
  "description": "Aggregate, public-safe telemetry for one daily literature-surveillance batch. It contains no candidate metadata or scientific decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "run_date",
    "window_start",
    "window_end",
    "timezone",
    "status",
    "repository_commit",
    "expected_sources",
    "sources",
    "totals",
    "assessments",
    "intake_issue",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "batch_id": {
      "type": "string",
      "pattern": "^ACADEMIC-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "run_date": {"type": "string", "format": "date"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Europe/Rome"},
    "status": {"enum": ["completed", "partial", "failed"]},
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["Consensus", "Exa"]}
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "totals": {"$ref": "#/$defs/totals"},
    "assessments": {"$ref": "#/$defs/assessments"},
    "intake_issue": {"$ref": "#/$defs/intakeIssue"},
    "notes": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 280}
    }
  },
  "$defs": {
    "nullableCount": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "queries_planned",
        "queries_completed",
        "occurrences_returned",
        "unique_results",
        "candidate_hits",
        "exclusive_candidates",
        "failure_code",
        "limitations"
      ],
      "properties": {
        "source": {"enum": ["Consensus", "Exa"]},
        "status": {"enum": ["completed", "failed", "not_run"]},
        "queries_planned": {"type": "integer", "minimum": 1},
        "queries_completed": {"type": "integer", "minimum": 0},
        "occurrences_returned": {"$ref": "#/$defs/nullableCount"},
        "unique_results": {"$ref": "#/$defs/nullableCount"},
        "candidate_hits": {"$ref": "#/$defs/nullableCount"},
        "exclusive_candidates": {"$ref": "#/$defs/nullableCount"},
        "failure_code": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 80},
            {"type": "null"}
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 180}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrences_returned",
        "unique_results",
        "known_matches",
        "intake_candidates",
        "not_forwarded",
        "unresolved_identity",
        "possible_duplicate_flags",
        "metadata_conflicts"
      ],
      "properties": {
        "occurrences_returned": {"$ref": "#/$defs/nullableCount"},
        "unique_results": {"$ref": "#/$defs/nullableCount"},
        "known_matches": {"$ref": "#/$defs/nullableCount"},
        "intake_candidates": {"$ref": "#/$defs/nullableCount"},
        "not_forwarded": {"$ref": "#/$defs/nullableCount"},
        "unresolved_identity": {"$ref": "#/$defs/nullableCount"},
        "possible_duplicate_flags": {"$ref": "#/$defs/nullableCount"},
        "metadata_conflicts": {"$ref": "#/$defs/nullableCount"}
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plausible_core", "plausible_contextual", "uncertain"],
      "properties": {
        "plausible_core": {"type": "integer", "minimum": 0},
        "plausible_contextual": {"type": "integer", "minimum": 0},
        "uncertain": {"type": "integer", "minimum": 0}
      }
    },
    "intakeIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "number", "url"],
      "properties": {
        "created": {"type": "boolean"},
        "number": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "url": {
          "oneOf": [
            {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
