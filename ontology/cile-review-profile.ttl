cile:contributionId a rdf:Property ; rdfs:label "contribution_id" .
cile:role a rdf:Property ; rdfs:label "role" .
cile:position a rdf:Property ; rdfs:label "position" .
cile:creditRoleUri a rdf:Property ; rdfs:label "credit_role_uri" .
