{
  "profile_version": "0.4.0",
  "schema": "schema/intake-open-access.schema.json",
  "artifact_pattern": "data/curation/intake_access/<batch_id>.json (scheduled or extraordinary)",
  "classes": [
    "AccessAssessment",
    "CandidateRecord",
    "Evidence"
  ],
  "receipt_fields": {
    "candidate_id": "candidate_id",
    "full_text_url": "oa_full_text_url",
    "version_type": "v2_version_type",
    "host_type": "oa_host_type",
    "license_uri": "v2_license_uri",
    "rights_basis": "v2_rights_basis",
    "rights_evidence_url": "oa_rights_evidence_url",
    "access_status": "oa_access_status",
    "verification_method": "oa_verification_method",
    "full_text_sha256": "oa_full_text_sha256",
    "verified_at": "oa_verified_at"
  },
  "snapshot_fields": {
    "schema_version": {
      "slot": "version",
      "transform": "decimal_string",
      "range": "string",
      "multivalued": false
    },
    "batch_id": {
      "slot": "event_id",
      "transform": "identity",
      "range": "string",
      "multivalued": false
    },
    "source_issue_number": {
      "slot": "was_derived_from",
      "transform": "github_issue_uri",
      "range": "uriorcurie",
      "multivalued": false
    },
    "source_body_sha256": {
      "slot": "v2_content_sha256",
      "transform": "identity",
      "range": "string",
      "multivalued": false
    },
    "receipts": {
      "containment": "AccessAssessment",
      "multivalued": true,
      "field_mapping": "receipt_fields"
    }
  },
  "authority": "OA-1 intake requirement; technical enforcement after the owner-requested audit.",
  "semantics": "Attributed discovery attestations, preserved with candidate provenance; never curator OA approval, canonical work creation or scientific eligibility. The JSON envelope is not an RDF entity property map: receipts is structural containment of individually mapped AccessAssessment records; each record derives from the single source issue URI. Integer schema version is rendered as a decimal string, and source issue number expands to the repository issue URI.",
  "acquisition_policy": "config/oa-acquisition.json"
}
