{
  "profile_version": "0.4.4",
  "contract": "CILE-DOCUMENT-REPOSITORY-1",
  "migrations": [
    "curator-app/migrations/0009_document_repository.sql"
  ],
  "tables": {
    "enrichment_manifestations": {
      "class": "Manifestation",
      "fields": {
        "manifestation_id": "manifestation_id",
        "target_id": "enrichment_target_id",
        "input_sha256": "enrichment_input_sha256",
        "source_url": "source_url",
        "version_label": "enrichment_version_label"
      }
    },
    "enrichment_document_bindings": {
