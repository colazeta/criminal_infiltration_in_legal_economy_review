        "manifestation_id": "manifestation_id"
      }
    },
    "enrichment_document_extractions": {
      "class": "ExtractedDocument",
      "fields": {
        "extraction_id": "document_extraction_id",
        "document_id": "document_document_id",
        "source_id": "enrichment_source_id",
        "text_sha256": "enrichment_content_sha256",
        "text_length": "document_text_length",
        "page_count": "document_page_count",
        "method": "document_extraction_method",
        "extractor_version": "document_extractor_version",
        "offset_unit": "document_offset_unit",
        "protocol_version": "enrichment_protocol_version",
        "observed_at": "enrichment_observed_at"
      }
    },
    "enrichment_document_pages": {
      "class": "DocumentPage",
      "fields": {
