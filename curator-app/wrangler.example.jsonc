{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "criminal-infiltration-curator",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUBMISSIONS",
        "class_name": "SubmissionCoordinator"
      },
      {
        "name": "ENRICHMENT_STORE",
        "class_name": "PaperEnrichmentStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SubmissionCoordinator"
      ]
    },
    {
      "tag": "v2-private-enrichment",
      "new_sqlite_classes": [
        "PaperEnrichmentStore"
      ]
    }
  ],
  "vars": {
    "GITHUB_REPOSITORY": "colazeta/criminal_infiltration_in_legal_economy_review",
    "GITHUB_REPOSITORY_ID": "1224850188",
    "CURATOR_LOGIN": "colazeta",
    "SITE_URL": "https://REPLACE_WITH_WORKER_HOST/curate.html",
    "GITHUB_CALLBACK_URL": "https://REPLACE_WITH_WORKER_HOST/auth/callback",
    "GITHUB_CLIENT_ID": "REPLACE_AFTER_GITHUB_APP_REGISTRATION",
    "JINA_READER_FREE_ONLY": "true",
    "SERPER_FREE_ONLY": "true",
    "SERPER_DEDICATED_FREE_ACCOUNT": "REPLACE_SERPER_DEDICATED_FREE_ACCOUNT",
    "EXA_FREE_ONLY": "true",
    "EXA_DEDICATED_STARTER_ACCOUNT": "REPLACE_EXA_DEDICATED_STARTER_ACCOUNT",
    "TAVILY_FREE_ONLY": "true",
    "PAPER_ENRICHMENT_ENABLED": "true",
    "PAPER_ENRICHMENT_STORAGE": "durable_object_sqlite"
  },
  "triggers": {
    "crons": [
      "7,22,37,52 * * * *",
      "40 * * * *"
    ]
  }
}
